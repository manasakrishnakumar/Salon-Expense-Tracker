# Only needed for testing on a physical device (or if the smart defaults
# in lib/api.js don't match your setup). Copy to .env and set to your dev
# machine's LAN IP with the backend's port, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:4000
#
# Defaults if unset: iOS simulator -> http://localhost:4000
#                     Android emulator -> http://10.0.2.2:4000
# EXPO_PUBLIC_API_URL=

# Where "Forgot password" recovery links should send the user to finish
# resetting their password (Appwrite emails a link with a userId+secret
# that only the web app currently knows how to consume — see
# web/src/pages/LoginPage.jsx's `?recovery=true` handling). Point this at
# your deployed web app's URL. If unset, the recovery email still sends,
# but the link in it won't resolve anywhere useful.
# EXPO_PUBLIC_WEB_URL=https://your-salon-pro-web-app.vercel.app
