# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Optional — error monitoring. Leave unset to disable entirely (default).
# Get a DSN from https://sentry.io if/when you want this on.
# SENTRY_DSN=

# Appwrite (server-side credentials — never expose these to a client/browser)
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=695f65ac002951c845ea
APPWRITE_API_KEY=replace-with-a-server-api-key-from-appwrite-console
APPWRITE_DATABASE_ID=695f66ba003081a9a85d

# Collection IDs (match web/mobile lib/appwrite.js)
COLLECTION_EXPENSES=expenses
COLLECTION_SERVICE_RECORDS=service_record
COLLECTION_RESTOCK=restock_history
COLLECTION_WORKERS=workers
COLLECTION_PRODUCTS=products
COLLECTION_AUDIT_LOG=audit_log
COLLECTION_SERVICE_PRICES=service_prices
